# Hostinger deploy target.
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
#
# Find these in Hostinger -> Websites -> (domain) -> SSH Access,
# and the remote path in Hostinger -> Files.

SSH_HOST=
SSH_PORT=65002
SSH_USER=
REMOTE_PATH=/home/<user>/websites/<site-id>/public_html

# Optional: Unsplash stock-image fetching (leave blank if unused)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
