# dependencies
node_modules/

# build output — regenerated by `npm run build`
dist/
.astro/

# deploy bundles (duplicated build output, bloat history)
*.zip
*-deploy/
*-build/
*-dist/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables — real secrets stay local, commit .env.example
.env
.env.production
.env.local
!.env.example

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# ---------------------------------------------------------------------------
# DO NOT ADD A BARE `images/` LINE.
#
# `images/` matches ANY directory named "images" at any depth — including
# public/images/, where real site photos live. The repo will then clone fine
# and serve 404 on every image.
#
# If a root-level SOURCE image folder must be excluded, anchor it:
#     /Images/
# ---------------------------------------------------------------------------
